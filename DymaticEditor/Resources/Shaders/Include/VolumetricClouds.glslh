// Volumetric Cloud Calculation Shader Header

#pragma once

#include Ray.glslh
#include Intersection.glslh

const int u_CloudSamples = 128*2;

const int numStepsLight = 8;
const float lightAbsorptionThroughCloud = 0.25; // 0.75 is good without environment map
const float lightAbsorptionTowardSun = 1.21;
const float darknessThreshold = 0.15;
const float forwardScattering = 0.811;
const float backScattering = 0.33;
const float cloudScale = 250.0;
const float verticalFalloff = 15.0;

const Box cloudBounds = Box(vec3(-500.0, 50.0, -500.0), vec3(500.0, 100.0, 500.0));

float remap(float x, float a, float b, float c, float d)
{
    return (((x - a) / (b - a)) * (d - c)) + c;
}

float beerPowder(float d, float a)
{
    const float beer = exp2(-d);
    const float powder = 1.0 - exp2(-2.0 * d);
    return mix(beer, beer * powder, 1.0 - a / PI);
}

// Henyey-Greenstein
float hg(float a, float g)
{
    float g2 = g * g;
    return (1.0 - g2) / (pow(1.0 + g2 - 2.0 * g * a, 1.5));
}

float phase(vec3 worldDirection, float g)
{
    const vec3 lightDir = normalize(u_DirectionalLight.direction.xyz);
    const float cosTheta = dot(lightDir, -worldDirection);
    return hg(cosTheta, g);
}

// Cloud density function based on world position
float sampleDensity(vec3 worldPos)
{
    const vec3 cloudDirection = vec3(1.0, 0.0, 1.0);
    worldPos += cloudDirection * u_Time;

    // Unpack perlin-worley noise from texture
    const float tiling = 400.0;
    const vec3 uv = worldPos / tiling;
    const vec4 perlinWorleySample = texture(u_PerlinWorley, uv);
    const float pfbm    = perlinWorleySample.r;
    const float worley0 = perlinWorleySample.g;
    const float worley1 = perlinWorleySample.b;
    const float worley2 = perlinWorleySample.a;

    // Use noise to generate cloud shaped density map
    float perlinWorley = remap(pfbm, 0.0, 1.0, worley0, 1.0);
    float wfbm = worley0 * 0.625 + worley1 * 0.125 + worley2 * 0.25;

    float cloud = remap(perlinWorley, wfbm - 1.0, 1.0, 0.0, 1.0);
    cloud = remap(cloud, 0.85, 1.0, 0.0, 1.0); // fake cloud coverage

    // Falloff
    const float falloff = clamp((worldPos.y - cloudBounds.Min.y) / verticalFalloff, 0.0, 1.0) * clamp((cloudBounds.Max.y - worldPos.y) / verticalFalloff, 0.0, 1.0);

    return cloud * falloff;
}

float lightmarch(vec3 position)
{
    float totalDensity = 0;

    vec3 dirToLight = -u_DirectionalLight.direction.xyz;

    Ray lightRay;
    lightRay.Origin = position;
    lightRay.Direction = dirToLight;

    float t0, t1;
    if (RayBoxIntersect(lightRay, cloudBounds, t0, t1))
    {
        float dstInsideBox = t1 - t0;
        
        float stepSize = dstInsideBox / numStepsLight;
        

        for (int step = 0; step < numStepsLight; step++)
        {
            position += dirToLight * stepSize;
            totalDensity += max(0, sampleDensity(position) * stepSize);
        }
    }

    float transmittance = beerPowder(totalDensity * lightAbsorptionTowardSun, 0.0);
    return darknessThreshold + transmittance * (1.0 - darknessThreshold);
}

vec3 CalculateVolumetricClouds(vec3 directLighting, vec3 position, float linearDepth)
{
    // TODO: Better system that will use larger steps until hitting a cloud, then backtrack and procedd through cloud
    // with lower step size until a few steps have occured without cloud.
    // Have a max distance rather than a max step count.

    Ray worldRay;
    worldRay.Origin = u_ViewPosition.xyz;
    worldRay.Direction = normalize(position - worldRay.Origin);
    float t0, t1;

    if (RayBoxIntersect(worldRay, cloudBounds, t0, t1))
    {
        vec3 start = worldRay.Origin + t0 * worldRay.Direction;
        vec3 end =  worldRay.Origin + t1 * worldRay.Direction;

        const vec3 step = (end - start) / float(u_CloudSamples);
        const float stepSize = length(step);
        vec3 cloudPosition = start;

        float transmittance = 1.0;
        vec3 lightEnergy = vec3(0.0);

        const float phaseValForward  = phase(worldRay.Direction,  forwardScattering);
        const float phaseValBackward = phase(worldRay.Direction, -backScattering);
        const float phaseVal = mix(phaseValBackward, phaseValForward, 0.5);

        float totalDepth = max(t0, 0.0);
        for (uint i = 0; i < u_CloudSamples; i++)
        {
            float density = sampleDensity(cloudPosition);
            if (density > 0.0)
            {
                float lightTransmittance = lightmarch(cloudPosition);

                lightEnergy += density * stepSize * transmittance * lightTransmittance * phaseVal;
                transmittance *= exp2(-density * stepSize * lightAbsorptionThroughCloud);

                // TODO: Some sort of coverage setting for noise

                // TODO: if transmittance is below 0.3, switch the lower detail (larger step) sampling step

                // Early exit when further samples will have minimal effect on result.
                if (transmittance < 0.01)
                    break;
            }

            if (totalDepth >= linearDepth)
                break;

            cloudPosition += step;
            totalDepth += stepSize;
        }

        const vec3 cloudColor = lightEnergy * u_DirectionalLight.color.rgb;
        return directLighting = directLighting * transmittance + cloudColor;
    }

    return directLighting;
}