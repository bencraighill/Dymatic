vec4 TraceCone(Ray ray, float coneAngle, float stepMultiplier)
{
    const vec3 normal = vec3(0.0);
    const float normalRayOffset = 0.0;
    return TraceCone(ray, normal, coneAngle, stepMultiplier, normalRayOffset, 1.0);
}
