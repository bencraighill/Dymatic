// Lighting Calculations Header File
#pragma once

#include DirectionalLighting.glslh
#include PointLighting.glslh

// Note: If light grid is not utilized (for light culling) linearDepth is not required
vec3 CalculateLighting(
    vec3 albedo, vec3 normal, vec3 emissive, float roughness, float metallic, vec3 specular, float ao, vec3 position, float linearDepth)
{
    vec3 radianceOut = vec3(0.0);

    // Components common to all light types
    vec3 viewDir = normalize(vec3(u_ViewPosition) - position);
    vec3 R = reflect(-viewDir, normal);

    // Correcting zero incidence reflection
    vec3 F0   = vec3(0.04);
    F0 = mix(F0, albedo, metallic);

    // Directional light
    if (u_UsingDirectionalLight == 1)
    {
        float shadow = DirectionalShadow(position, normal);
        radianceOut = DirectionalLighting(u_DirectionalLight, normal, viewDir, albedo, roughness, metallic, shadow, F0);
    }

    // Point lights
    float viewDistance = length(vec3(u_ViewPosition) - position);

#ifdef USE_LIGHT_GRID

    // Locating which cluster you are a part of
    uint zTile     = uint(max(log2(linearDepth) * u_Scale + u_Bias, 0.0));
    uvec3 tiles    = uvec3(uvec2(gl_FragCoord.xy / u_TileSizes[3]), zTile);
    uint tileIndex = tiles.x +
                     u_TileSizes.x * tiles.y +
                     (u_TileSizes.x * u_TileSizes.y) * tiles.z;
    
    uint lightCount       = u_LightGrid[tileIndex].count;
    uint lightIndexOffset = u_LightGrid[tileIndex].offset;

    // Reading from the global light list and calculating the radiance contribution of each light.
    for (uint i = 0; i < lightCount; i++)
    {
        uint lightVectorIndex = u_GlobalLightIndexList[lightIndexOffset + i];
        radianceOut += PointLighting(lightVectorIndex, normal, position, viewDir, albedo, roughness, metallic, F0, viewDistance);
    }

#else

    for (uint i = 0; i < u_PointLightCount; i++)
        radianceOut += PointLighting(i, normal, position, viewDir, albedo, roughness, metallic, F0, viewDistance);

#endif

    // If IBL is enabled use environment map for rough incoming light approximation for the fragment otherwise use constant fallback.
    vec3 ambient = vec3(0.0) * albedo;
    if (u_UsingSkyLight == 1) // IBL Enabled
    {
        if (linearDepth >= u_ZFar - 1)
        {
            // Background Skybox
            if (u_UsingFlowMap == 1)
            {
                // With Flow Map
                const float speedFactor = 0.25;
                vec3 flowSample = ((texture(u_FlowMap, -viewDir).rgb - 0.5) * 2.0);
                vec3 skyboxA = texture(u_EnvironmentMap, (-viewDir + ((fract((u_Time * speedFactor))) * flowSample))).rgb;
                vec3 skyboxB = texture(u_EnvironmentMap, (-viewDir + ((fract((u_Time * speedFactor + 0.5)) ) * flowSample))).rgb;

                radianceOut = mix(skyboxA, skyboxB, ((asin(cos(u_Time * speedFactor * PI * 2.0))) + (PI * 0.5)) / PI) * u_SkyLightIntensity;
            }
            else
            {
                // Without flow map
                radianceOut = texture(u_EnvironmentMap, -viewDir).rgb * u_SkyLightIntensity;
            }
        }
        else
        {
            // PBR Skybox Calculations
            vec3  kS = fresnelSchlickRoughness(max(dot(normal, viewDir), 0.0), F0, roughness);
            vec3  kD = 1.0 - kS;
            kD *= 1.0 - metallic;
            vec3 irradiance = texture(u_IrradianceMap, normal).rgb * u_SkyLightIntensity;
            vec3 diffuse    = irradiance * albedo;

            const float MAX_REFLECTION_LOD = 4.0;
            vec3 prefilteredColor = textureLod(u_PrefilterMap, R, roughness * MAX_REFLECTION_LOD).rgb * u_SkyLightIntensity;
            vec2 envBRDF = texture(u_brdfLUT, vec2(max(dot(normal, viewDir), 0.0), roughness)).rg;
            vec3 specular = prefilteredColor * (kS * envBRDF.x + envBRDF.y);
            ambient = (kD * diffuse + specular);
        }
    }
	
    radianceOut += ambient;

	// Apply ambient occlusion
	radianceOut *= ao;

    // Adding any emissive if there is an assigned map
    radianceOut += emissive;

    return radianceOut;
}