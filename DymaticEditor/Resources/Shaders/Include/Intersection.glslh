// Primative Intersection Utilities

#pragma once
#include Ray.glslh
#include Box.glslh

// Note: If we have lots of different intersection functions in this header, we could add a macro to each
// primative file and do #ifdef tests to only enable functions if they are defined

bool RayBoxIntersect(Ray ray, Box box, out float t1, out float t2)
{
    t1 = FLT_MIN;
    t2 = FLT_MAX;

    vec3 t0s = (box.Min - ray.Origin) / ray.Direction;
    vec3 t1s = (box.Max - ray.Origin) / ray.Direction;

    vec3 tsmaller = min(t0s, t1s);
    vec3 tbigger = max(t0s, t1s);

    t1 = max(t1, max(tsmaller.x, max(tsmaller.y, tsmaller.z)));
    t2 = min(t2, min(tbigger.x, min(tbigger.y, tbigger.z)));

    return t1 <= t2 && t2 > 0.0;
}